{
  "name": "@kult/create",
  "version": "0.1.0",
  "private": true,
  "description": "Kult Create: the game-studio building in Kult World. Players sign in with Privy, their KULT agent (AI Arena INFT on 0G) becomes CEO of their studio, and the compute layer's agents work as employees in an isometric pixel office.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build --config privy-login/vite.config.js"
  },
  "dependencies": {
    "@privy-io/node": "^0.26.0",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@privy-io/react-auth": "^3.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "vite": "^7.3.1"
  }
}
