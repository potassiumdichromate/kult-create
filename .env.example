PORT=4300
NODE_ENV=development
# Public URL of this service (the office is served at /office/).
PUBLIC_URL=http://localhost:4300
# HMAC secret for session tokens. Required in production: openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=7
# Origins allowed to embed the office in an iframe and call the API (Kult World).
# Comma-separated, or * for any.
ALLOWED_ORIGINS=*

# Privy: the SAME Privy app Kult World and AI Arena log players in with
# (dashboard → App settings). Players arriving from Kult World are signed in
# with their Privy session; the identity token must be enabled in Privy.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Optional: lets an access token alone work (looks the user up via Privy API).
PRIVY_APP_SECRET=

# Storage: MongoDB in production (can share the creator-studio cluster; uses its
# own database). Without it, a JSON file is used (single instance, dev only).
MONGODB_URI=
MONGODB_DB=kult_create
DATA_FILE=

# Credits
STARTING_CREDITS=1000
CREDIT_COST_PRO=40
CREDIT_COST_ULTRA=100
CREDIT_COST_EDIT=10

# OKX.ai identity: ERC-8004 IdentityRegistry on X Layer (chain 196).
XLAYER_RPC_URL=https://rpc.xlayer.tech
OKX_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# "off" skips the ownership check (the agent must still exist on chain).
OKX_IDENTITY_VERIFY=on

# CEO: the owner's KULT agent, an AI Arena INFT (ERC-7857) on 0G mainnet.
ZEROG_RPC_URL=https://evmrpc.0g.ai
CEO_INFT_CONTRACT=0xA8A5a1D6AA3BF4575f6a1031966C8079BD4e9b9b
# AI Arena mints every agent to this custodian wallet.
CEO_INFT_CUSTODIAN=0x043091b10bBcD3F8C5158C27AD291CC56B4F46db
# arena     = AI Arena's database binds the agent to the wallet, and the contract
#             maps that agent ID to the token (default when AI_ARENA_DATABASE_URL is set)
# strict    = the wallet must own the INFT or have ERC-7857 usage (hasValidUsage)
# custodial = strict, plus accept agents still held by the custodian (no proof of ownership)
# off       = no chain check (tests only)
CEO_INFT_VERIFY=arena
# AI Arena Postgres. Use a read-only role; only SELECTs on "User" and "Agent" are made.
AI_ARENA_DATABASE_URL=

# KULT compute layer (builds the games). Key = COMPUTE_API_KEY on the compute layer.
COMPUTE_LAYER_URL=http://localhost:4100
COMPUTE_LAYER_KEY=
PRODUCTION_POLL_MS=2000

# Creator studio (stores and publishes games). Key = KULT_CREATE_SERVICE_KEY there.
CREATOR_STUDIO_URL=http://localhost:3001
CREATOR_STUDIO_KEY=
